{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reader": {
      "type": "stdio",
      "command": "node",
      "env": {
        "READER_PLUGIN_TARGET": "arknights-story-reader@arknights-reader"
      },
      "args": [
        "${PLUGIN_ROOT}/dist/server/production.js",
        "--stdio",
        "--installed"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
