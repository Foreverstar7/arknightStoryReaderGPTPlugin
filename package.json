{
  "version": "0.1.26",
  "name": "arknights-story-reader",
  "description": "PRTS story reader MCP App with local reading history",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foreverstar7/arknightStoryReaderGPTPlugin.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "arknights-story-reader": "dist/server/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/server/main.js",
    "!dist/data/fixture.js",
    "dist/ui/index.html",
    "plugin.json",
    "mcp.json"
  ],
  "bundleDependencies": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "start:stdio": "node dist/server/main.js --stdio",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:prts": "playwright test -c playwright.prts.config.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html",
    "check": "npm run typecheck && npm test && npm run format:check",
    "plugin:prepare": "tsx scripts/prepare-plugin.ts",
    "package": "npm run build && tsx scripts/pack.ts",
    "package:verify": "tsx scripts/verify-package.ts",
    "release:version": "tsx scripts/set-version.ts",
    "probe:mcp": "tsx scripts/probe-mcp.ts",
    "probe:http": "tsx scripts/probe-http.ts",
    "probe:prts": "tsx scripts/probe-prts.ts",
    "probe:prts:s3": "tsx scripts/probe-prts-s3.ts",
    "probe:prts:s4": "tsx scripts/probe-prts-s4.ts",
    "probe:s4:installed": "tsx scripts/probe-s4-installed.ts",
    "audit:covers": "tsx scripts/audit-prts-covers.ts",
    "audit:chapters": "tsx scripts/audit-prts-chapters.ts",
    "audit:images": "tsx scripts/audit-prts-images.ts",
    "audit:refactor": "tsx scripts/refactoring-baseline.ts",
    "probe:images": "tsx scripts/probe-prts-body-images.ts",
    "probe:covers": "tsx scripts/probe-covers.ts",
    "probe:host": "tsx scripts/probe-host.ts",
    "marketplace:promote": "tsx scripts/promote-marketplace.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "image-size": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "npm@12.2.1"
}
