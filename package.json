{
  "name": "arknights-story-reader",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "start:stdio": "node dist/server/main.js --stdio",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html",
    "check": "npm run typecheck && npm test && npm run format:check",
    "plugin:prepare": "tsx scripts/prepare-plugin.ts",
    "probe:mcp": "tsx scripts/probe-mcp.ts",
    "probe:http": "tsx scripts/probe-http.ts",
    "probe:host": "tsx scripts/probe-host.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "npm@12.2.1"
}
